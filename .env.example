# Environment Variables Configuration
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: .env.local is Git-ignored for security!

# ============================================================================
# PROXMOX VE CONFIGURATION
# ============================================================================

# Proxmox VE API endpoint
# Format: https://<proxmox-host-or-ip>:8006/
# Example: https://10.0.0.1:8006/ or https://pve.example.com:8006/
export PROXMOX_VE_ENDPOINT="https://your-proxmox-host:8006/"

# Proxmox VE API Token
# Format: user@pam!token-name=token-secret
# To create a token:
#   1. Log into Proxmox Web UI
#   2. Go to Datacenter → Permissions → API Tokens
#   3. Click "Add" and copy the full token value
# Example: user@pam!mytoken=e8f7d4c2-9a1b-4e6f-8c3d-2b5a1f9e4d7c
export PROXMOX_VE_API_TOKEN="user@pam!token-name=token-secret"

# Pass Proxmox token to Terraform
export TF_VAR_api_token="${PROXMOX_VE_API_TOKEN}"

# ============================================================================
# TERRAFORM VARIABLES (Optional - can also use terraform.tfvars)
# ============================================================================

# Proxmox node name where VMs will be created
# Example: pve-lab, prox1, lab-node-01
# export TF_VAR_target_node="lab-training-day"

# Proxmox VE endpoint (alternative to PROXMOX_VE_ENDPOINT)
# export TF_VAR_proxmox_endpoint="${PROXMOX_VE_ENDPOINT}"

# Domain for your cluster VMs
# export TF_VAR_domain="training.local"

# ============================================================================
# ANSIBLE CONFIGURATION (Optional)
# ============================================================================

# Ansible Python interpreter
# export ANSIBLE_PYTHON_INTERPRETER=/usr/bin/python3

# Ansible SSH user (if different from 'ubuntu')
# export ANSIBLE_USER=ubuntu

# ============================================================================
# KUBERNETES / KUBECONFIG (Post-Deployment)
# ============================================================================

# After cluster is created, Terraform outputs kubeconfig location:
# export KUBECONFIG=$PWD/kubeconfig

# Or for kubectl:
# export KUBECONFIG=/home/ubuntu/.kube/config

# ============================================================================
# OPTIONAL: CI/CD VARIABLES
# ============================================================================

# Terraform log level: TRACE, DEBUG, INFO, WARN, ERROR
# export TF_LOG=DEBUG

# Terraform state file location (advanced)
# export TF_STATE_PATH=./terraform.tfstate

# ============================================================================
# SECURITY NOTES
# ============================================================================

# ⚠️  DO NOT:
#   • Commit this file to Git with real values
#   • Share your PROXMOX_VE_API_TOKEN with others
#   • Use this token for more than one purpose
#   • Rotate token in .env files - use Proxmox UI instead

# ✅ DO:
#   • Copy this file to .env.local (Git-ignored)
#   • Restrict file permissions: chmod 600 .env.local
#   • Rotate tokens regularly in Proxmox UI
#   • Back up your .env.local securely (encrypted vault)
#   • Use source .env.local before running terraform

# ============================================================================
# USAGE
# ============================================================================

# Before running Terraform:
#   1. Copy this file: cp .env.example .env.local
#   2. Edit .env.local with your actual values
#   3. Source the environment: source .env.local
#   4. Run Terraform: terraform apply
#
# Or alternatively, create terraform.tfvars:
#   api_token         = "user@pam!token=..."
#   proxmox_endpoint  = "https://10.0.0.1:8006/"
#   target_node       = "pve-lab"
